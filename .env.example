AZURE_TENANT_ID=pon-aqui-tu-tenant-id
AZURE_CLIENT_ID=pon-aqui-tu-client-id

# EP3 - RabbitMQ (elige tu propia clave; NO subas el archivo .env a GitHub)
RABBITMQ_USER=vidasalud
RABBITMQ_PASSWORD=cambia-esta-clave

# (Opcional) Para usar el clúster de 2 nodos de la carpeta mq/ en vez del RabbitMQ del compose:
# RABBITMQ_HOST=host.docker.internal
# RABBITMQ_PORT=5673
# RABBITMQ_MANAGEMENT_URL=http://host.docker.internal:15673
